<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OpenDrop Web UI LaunchAgent template (loopback-only page on :8655).
  Installed via scripts/install-mac.sh — placeholders stamped at install time.
  Placeholders: __OPENDROP_BIN__  __OPENDROP_WORKDIR__  __HOME__
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.opendrop.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>__OPENDROP_BIN__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__OPENDROP_WORKDIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.opendrop/web.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.opendrop/web.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
